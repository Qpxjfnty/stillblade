{
  "name": "stillblade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "Defensive Unicode arena combat with frozen-time attack turns.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "qa": "node scripts/browser-qa.mjs",
    "qa:interaction": "node scripts/interaction-qa.mjs",
    "solve": "tsx scripts/solve.ts"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
